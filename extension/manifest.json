{
  "manifest_version": 3,
  "name": "AI LeetCode 私教",
  "version": "0.1.0",
  "description": "智能刷题教练 — Chrome 扩展，在 LeetCode 做题时自动跟踪、打分、推送",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "*://leetcode.com/*",
    "*://leetcode.cn/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "AI LeetCode 私教"
  },
  "background": {
    "service_worker": "background/worker.js"
  },
  "content_scripts": [
    {
      "matches": ["*://leetcode.com/problems/*", "*://leetcode.cn/problems/*"],
      "js": ["content/task-sidebar.js", "content/rating-popup.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "__note_update_url": "Replace with real URL after publishing to Chrome Web Store. Format: https://clients2.google.com/service/update2/crx",
  "update_url": "https://clients2.google.com/service/update2/crx"
}
