# ── AI LeetCode Coach — Environment Configuration ──────────────────
# Copy this file to .env and fill in real values.
#
#   cp .env.example .env
#
# Required variables are marked with [REQUIRED].
# Optional variables have defaults or safe fallbacks.

# ── Database ─────────────────────────────────────────────────────────
# PostgreSQL connection string for Prisma ORM.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# [REQUIRED]
DATABASE_URL="postgresql://aitoearn:YOUR_DB_PASSWORD@localhost:5432/aitoearn"

# ── Redis ───────────────────────────────────────────────────────────
# Redis connection string for session caching and scheduler queue.
# Format: redis://HOST:PORT
# [REQUIRED if using scheduler]
REDIS_URL="redis://localhost:6379"

# ── NextAuth (JWT + Session) ────────────────────────────────────────
# Secret used to sign NextAuth JWT tokens.
# Generate with: openssl rand -base64 32
# [REQUIRED]
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# Public-facing URL of your app (used for callback URLs).
# Development:  http://localhost:3000
# Production:   https://yourdomain.com
# [REQUIRED]
NEXTAUTH_URL="http://localhost:3000"

# ── WeChat OAuth (PC QR Code Login) ────────────────────────────────
# 1. Register at https://open.weixin.qq.com/
# 2. Create a Website App to get AppID and AppSecret
# 3. Set callback URL: {NEXTAUTH_URL}/api/auth/callback/wechat
# [REQUIRED for WeChat login]
WECHAT_APP_ID="your-wechat-app-id"
WECHAT_APP_SECRET="your-wechat-app-secret"

# ── Stripe (Payment Processing) ────────────────────────────────────
# Stripe secret key (starts with sk_live_ in production).
# Get from: https://dashboard.stripe.com/apikeys
# [REQUIRED for subscriptions]
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxx"

# Stripe publishable key (starts with pk_live_ in production).
# Used client-side by Stripe.js.
# [REQUIRED for subscriptions]
NEXT_PUBLIC_STRIPE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxx"

# Stripe webhook signing secret (starts with whsec_).
# Configure at: https://dashboard.stripe.com/webhooks
# Endpoint: {NEXTAUTH_URL}/api/payment/webhook
# [REQUIRED for subscription lifecycle management]
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxx"

# Stripe Price ID for the monthly subscription.
# Create a product and price in Stripe Dashboard → Products.
# [REQUIRED for subscriptions]
STRIPE_PRICE_ID="price_xxxxxxxxxxxxxxxx"

# ── App URL (public) ────────────────────────────────────────────────
# Used by Stripe Checkout for success/cancel redirects and by payment
# webhook for customer portal URLs.
# Should match NEXTAUTH_URL in most cases.
# [REQUIRED for Stripe Checkout]
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── PostgreSQL Credentials (Docker Compose only) ──────────────────
# Used by docker-compose.prod.yml to configure the Postgres container.
# These are NOT read by the Next.js app directly.
# [REQUIRED if using docker-compose.prod.yml]
POSTGRES_USER="aitoearn"
POSTGRES_PASSWORD="YOUR_DB_PASSWORD"
POSTGRES_DB="aitoearn"

# ── Monitoring ─────────────────────────────────────────────────────
# Sentry DSN for error tracking.
# Get from: https://sentry.io/settings/{project}/keys/
# [Optional]
SENTRY_DSN="https://xxxxxxxxxxxxxxxx@sentry.io/xxxxxxx"

# Sentry auth token for source map uploads (server-side only, keep secret).
# Generate at: https://sentry.io/settings/account/api/auth-tokens/
# [Optional — required for source maps]
# SENTRY_AUTH_TOKEN="sntrys_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Sentry organization slug (for source map uploads).
# [Optional]
# SENTRY_ORG="your-org-slug"

# Sentry project slug (for source map uploads).
# [Optional]
# SENTRY_PROJECT="aitoearn-app"

# ── Backblaze B2 (Database Backups) ──────────────────────────────
# Backblaze B2 Application Key ID.
# Create at: https://secure.backblaze.com/app_keys.htm
# [Optional — required for automated backup uploads]
# BACKBLAZE_B2_KEY_ID="004xxxxxxxxxxxxxxxx"

# Backblaze B2 Application Key.
# [Optional]
# BACKBLAZE_B2_APP_KEY="K001xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Backblaze B2 bucket name for database backups.
# [Optional]
# BACKBLAZE_B2_BUCKET="aitoearn-backups"

# ── Scheduler (Python Daily Push Engine) ───────────────────────────
# Cron expression for the daily push scheduler.
# Default: run daily at 07:00 UTC = 15:00 CST
# [Optional]
SCHEDULER_CRON="0 7 * * *"

# ── SSL / Domain (Production) ──────────────────────────────────────
# Your production domain name (for Nginx and Let's Encrypt).
# [REQUIRED for production deployment]
# DOMAIN="yourdomain.com"
# ADMIN_EMAIL="admin@yourdomain.com"
